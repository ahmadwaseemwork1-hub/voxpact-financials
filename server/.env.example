# ---------------------------------------------------------------------------
# Voxpact Financials — server environment
# Copy to .env and fill in real values.  NEVER commit .env
# ---------------------------------------------------------------------------

# PostgreSQL connection string
# Local docker-compose default:
DATABASE_URL="postgresql://voxpact:voxpact_local_pw@localhost:5432/voxpact_financials?schema=public"

# HTTP
PORT=4000
NODE_ENV=development

# Comma separated list of allowed browser origins
CORS_ORIGIN="http://localhost:5173"

# ---------------------------------------------------------------------------
# Security — GENERATE YOUR OWN. e.g.  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ---------------------------------------------------------------------------
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="24h"
BCRYPT_ROUNDS=12

# Session inactivity auto-logout (minutes) — enforced on client + server
INACTIVITY_TIMEOUT_MINUTES=30

# Login rate limiting
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15

# ---------------------------------------------------------------------------
# Seed accounts (used ONLY by `npm run db:seed`)
# Change these before deploying anywhere public.
# ---------------------------------------------------------------------------
SEED_HOST_USERNAME="ahmad.waseem"
SEED_HOST_PASSWORD="Host#2026"
SEED_HOST_EMAIL="ahmad.waseem.work1@gmail.com"

SEED_ADMIN_USERNAME="voxpactadmin"
SEED_ADMIN_PASSWORD="voxpact123"
SEED_ADMIN_EMAIL="admin@voxpact.com"

# Force the seeded accounts to change password on first login (recommended: true)
SEED_FORCE_PASSWORD_CHANGE=true

# ---------------------------------------------------------------------------
# Uploads
# ---------------------------------------------------------------------------
UPLOAD_DIR="uploads"
MAX_UPLOAD_MB=10

# Business defaults
DEFAULT_DAILY_BUDGET=20000
CURRENCY="USD"
